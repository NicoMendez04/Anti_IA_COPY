PORT=3001
PUBLIC_APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Correos (separados por coma) que se convierten en administradores al entrar
ADMIN_EMAILS=tu-correo@ejemplo.com
# Dominios que pueden entrar con Microsoft (separados por coma). Los estudiantes de estos
# dominios se aprueban solos; los profesores siempre quedan pendientes. Vacío = sin restricción
# y todos quedan pendientes.
ALLOWED_EMAIL_DOMAINS=uni.cl,alumnos.uni.cl
# Clave de servicio de Firebase: JSON en una línea o en base64.
# En local también sirve colocar backend/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT=
